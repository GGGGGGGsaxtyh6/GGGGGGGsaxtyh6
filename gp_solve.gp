m = 10124460123717732577;
B = 3120090466259654766880909097573553950487818021670727992039931232537173262599219376624291488340607228938989670215080876932583555412966984946786628621917436142053528648425399877486481618672307477414787846984446437445450282569184963;
ks = 263928838896714332657762314348602240455087661491500131260179929152321790693260683004004767933801216877412896467528419672112455669506824987777448696213888416333755744665868795853306879814179767910033263081341240785125410643513418;

B_mod = B % m;
ks_mod = ks % m;

print("Resolviendo logaritmo discreto para el primer factor...");
print("B^x = ", ks_mod, " (mod ", m, ")");

\\ Usar znlog para logaritmo discreto
x = znlog(Mod(ks_mod, m), Mod(B_mod, m));
print("Solución: x = ", x);

\\ Verificar
verify = lift(Mod(B_mod, m)^x);
print("Verificación: B^x mod m = ", verify);
print("Coincide: ", verify == ks_mod);

quit;
