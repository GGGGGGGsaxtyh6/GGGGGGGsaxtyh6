# HackTheBox MCP Server Configuration
# IMPORTANTE: Reemplaza TU_TOKEN_AQUI con tu token real de HackTheBox
HTB_TOKEN=TU_TOKEN_AQUI

# Configuración del servidor (no cambiar a menos que sea necesario)
SERVER_PORT=3000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=100
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30